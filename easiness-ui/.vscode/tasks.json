{
    "version": "2.0.0",
    "tasks": [
      {
        "label": "Build.Main",
        "type": "shell",
        "command": "npm run electron:serve-tsc",
        "isBackground": false,
        "group": {
          "kind": "build",
          "isDefault": true
        },
        "problemMatcher": {
          "owner": "typescript",
          "source": "ts",
          "applyTo": "closedDocuments",
          "fileLocation": ["relative", "${cwd}"],
          "pattern": "$tsc",
          "background": {
            "activeOnStart": true,
            "beginsPattern": "^.*",
            "endsPattern": "^.*Terminal will be reused by tasks, press any key to close it.*"
          }
        }
      },
      {
        "label": "Build.Renderer",
        "type": "shell",
        "command": "npm run ng:serve",
        "isBackground": true,
        "group": {
          "kind": "build",
          "isDefault": true
        },
        "problemMatcher": {
          "owner": "typescript",
          "source": "ts",
          "applyTo": "closedDocuments",
          "fileLocation": ["relative", "${cwd}"],
          "pattern": "$tsc",
          "background": {
            "activeOnStart": true,
            "beginsPattern": "^.*",
            "endsPattern": "^.*Compiled successfully.*"
          }
        }
      },
      {
        // See https://go.microsoft.com/fwlink/?LinkId=733558
        // for the documentation about the tasks.json format
        "label": "tsc",
        "command": "node_modules/.bin/tsc.cmd",
        "type": "shell",
        "args": ["-p", "tsconfig.serve.json"],
        "problemMatcher": "$tsc"
    }
    ]
  }